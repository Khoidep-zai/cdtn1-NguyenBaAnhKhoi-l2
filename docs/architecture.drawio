        <mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;SƠ ĐỒ THIẾT KẾ KIẾN TRÚC PHÂN LỚP (LAYERED ARCHITECTURE) - LUỒNG L2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Hệ thống: Mekong Mobile CRM | Mô hình 4 tầng | Tích hợp hệ sinh thái Mekong Core&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1080" height="50" as="geometry" />
