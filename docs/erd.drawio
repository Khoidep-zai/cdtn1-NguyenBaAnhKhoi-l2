        <!-- LEGEND BOX -->
        <mxCell id="legend_box" value="&lt;div style=&quot;font-weight: 700; color: #F8FAFC; margin-bottom: 6px; font-size: 12px; border-bottom: 1px solid #334155; padding-bottom: 4px;&quot;&gt;CHÚ GIẢI KÝ HIỆU (LEGEND)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.6; color: #94A3B8;&quot;&gt;&lt;span style=&quot;color: #F59E0B; font-weight: 700;&quot;&gt;PK&lt;/span&gt;: Khóa chính (Primary Key)&lt;br&gt;&lt;span style=&quot;color: #06B6D4; font-weight: 700;&quot;&gt;FK&lt;/span&gt;: Khóa ngoại (Foreign Key)&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;*&lt;/span&gt;: Bắt buộc (NOT NULL)&lt;br&gt;&lt;span style=&quot;color: #38BDF8;&quot;&gt;[UQ]&lt;/span&gt;: Giá trị duy nhất (UNIQUE)&lt;br&gt;&lt;span style=&quot;color: #60A5FA; font-weight: 700;&quot;&gt;1 : N&lt;/span&gt;: Quan hệ Crow&#39;s Foot (Một - Nhiều)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;strokeWidth=1;align=left;verticalAlign=top;padding=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="560" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- NOTE BOX REGARDING SLA & BUSINESS RULES -->
        <mxCell id="rule_box" value="&lt;div style=&quot;font-weight: 700; color: #F8FAFC; margin-bottom: 6px; font-size: 12px; border-bottom: 1px solid #334155; padding-bottom: 4px;&quot;&gt;RÀNG BUỘC NGHIỆP VỤ CỐT LÕI (SRS L2)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.6; color: #94A3B8;&quot;&gt;• &lt;strong style=&quot;color: #E2E8F0;&quot;&gt;QT-01:&lt;/strong&gt; SĐT khách hàng là UNIQUE. Trùng SĐT sẽ tái sử dụng hồ sơ.&lt;br&gt;• &lt;strong style=&quot;color: #E2E8F0;&quot;&gt;QT-04:&lt;/strong&gt; Hạn SLA sinh tự động theo Priority (CAO: 24h, TRUNG_BÌNH: 72h).&lt;br&gt;• &lt;strong style=&quot;color: #E2E8F0;&quot;&gt;QT-06:&lt;/strong&gt; Chuyển trạng thái 1 chiều, mọi thay đổi đều ghi vào ticket_status_log.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;strokeWidth=1;align=left;verticalAlign=top;padding=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="690" height="120" as="geometry" />
        </mxCell>

