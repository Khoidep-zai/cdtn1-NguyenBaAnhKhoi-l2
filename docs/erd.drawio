        <!-- ENTITY 4: TICKET (CENTERPIECE) -->
        <mxCell id="Ticket" value="&lt;div style=&quot;background: #4338CA; color: #FFFFFF; font-weight: 800; font-size: 14px; text-align: center; padding: 7px 0; border-bottom: 2px solid #818CF8;&quot;&gt;TICKET (Phiếu bảo hành)&lt;/div&gt;&lt;div style=&quot;padding: 10px 12px; font-family: &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11.5px; line-height: 1.7; color: #F1F5F9;&quot;&gt;&lt;span style=&quot;color: #F59E0B; font-weight: 700;&quot;&gt;PK&lt;/span&gt;  ticket_id : BIGSERIAL&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  ticket_code : VARCHAR(20) &lt;span style=&quot;color: #38BDF8;&quot;&gt;[UQ]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #06B6D4; font-weight: 700;&quot;&gt;FK&lt;/span&gt;  customer_id : BIGINT&lt;br&gt;&lt;span style=&quot;color: #06B6D4; font-weight: 700;&quot;&gt;FK&lt;/span&gt;  device_id : BIGINT&lt;br&gt;&lt;span style=&quot;color: #06B6D4; font-weight: 700;&quot;&gt;FK&lt;/span&gt;  category_id : INT &lt;span style=&quot;color: #94A3B8;&quot;&gt;(null)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  center_id : BIGINT&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  issue_desc : TEXT&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  priority : VARCHAR(10)&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  status : VARCHAR(20)&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  received_at : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  due_date : TIMESTAMP &lt;span style=&quot;color: #38BDF8;&quot;&gt;(SLA)&lt;/span&gt;&lt;br&gt;   closed_at : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  is_warranty : BOOLEAN&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#818CF8;strokeWidth=2;verticalAlign=top;align=left;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="410" y="150" width="280" height="340" as="geometry" />
        </mxCell>

        <!-- ENTITY 5: TICKET_STATUS_LOG -->
        <mxCell id="Log" value="&lt;div style=&quot;background: #1E3A8A; color: #FFFFFF; font-weight: 700; font-size: 13px; text-align: center; padding: 6px 0; border-bottom: 2px solid #3B82F6;&quot;&gt;TICKET_STATUS_LOG (Nhật ký xử lý)&lt;/div&gt;&lt;div style=&quot;padding: 10px 12px; font-family: &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11.5px; line-height: 1.7; color: #F1F5F9;&quot;&gt;&lt;span style=&quot;color: #F59E0B; font-weight: 700;&quot;&gt;PK&lt;/span&gt;  log_id : BIGSERIAL&lt;br&gt;&lt;span style=&quot;color: #06B6D4; font-weight: 700;&quot;&gt;FK&lt;/span&gt;  ticket_id : BIGINT&lt;br&gt;   from_status : VARCHAR(20)&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  to_status : VARCHAR(20)&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  changed_at : TIMESTAMP&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  changed_by : BIGINT&lt;br&gt;   note : VARCHAR(255)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=1.5;verticalAlign=top;align=left;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="790" y="360" width="260" height="180" as="geometry" />
        </mxCell>

        <!-- RELATIONSHIP 1: CUSTOMER -> DEVICE (1 : 0..*) -->
        <mxCell id="EdgeCusDev" value="1 : 0..*&#10;(sở hữu)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;startArrow=ERmandOne;startFill=0;endArrow=ERmany;endFill=0;strokeWidth=2;strokeColor=#60A5FA;fontColor=#CBD5E1;fontSize=11;fontStyle=1;" edge="1" parent="1" source="Customer" target="Device">
