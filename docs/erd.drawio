        <mxCell id="EdgeDevTic" value="1 : 0..* (bảo hành)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;startArrow=ERmandOne;startFill=0;endArrow=ERmany;endFill=0;strokeWidth=2;strokeColor=#60A5FA;fontColor=#CBD5E1;fontSize=11;fontStyle=1;" edge="1" parent="1" source="Device" target="Ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RELATIONSHIP 4: ISSUE_CATEGORY -> TICKET (1 : 0..*) -->
        <mxCell id="EdgeCatTic" value="1 : 0..* (phân loại)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;startArrow=ERmandOne;startFill=0;endArrow=ERmany;endFill=0;strokeWidth=2;strokeColor=#60A5FA;fontColor=#CBD5E1;fontSize=11;fontStyle=1;" edge="1" parent="1" source="Category" target="Ticket">
