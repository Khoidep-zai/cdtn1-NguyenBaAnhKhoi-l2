        <!-- ENTITY 1: CUSTOMER -->
        <mxCell id="Customer" value="&lt;div style=&quot;background: #1E3A8A; color: #FFFFFF; font-weight: 700; font-size: 13px; text-align: center; padding: 6px 0; border-bottom: 2px solid #3B82F6;&quot;&gt;CUSTOMER (Khách hàng)&lt;/div&gt;&lt;div style=&quot;padding: 10px 12px; font-family: &#39;JetBrains Mono&#39;, Consolas, monospace; font-size: 11.5px; line-height: 1.7; color: #F1F5F9;&quot;&gt;&lt;span style=&quot;color: #F59E0B; font-weight: 700;&quot;&gt;PK&lt;/span&gt;  customer_id : BIGSERIAL&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  full_name : VARCHAR(120)&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  phone : VARCHAR(20) &lt;span style=&quot;color: #38BDF8;&quot;&gt;[UQ]&lt;/span&gt;&lt;br&gt;   email : VARCHAR(120)&lt;br&gt;   address : VARCHAR(255)&lt;br&gt;&lt;span style=&quot;color: #EF4444; font-weight: 700;&quot;&gt;* &lt;/span&gt;  created_at : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=1.5;verticalAlign=top;align=left;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="250" height="175" as="geometry" />
        </mxCell>

        <!-- ENTITY 2: DEVICE -->
