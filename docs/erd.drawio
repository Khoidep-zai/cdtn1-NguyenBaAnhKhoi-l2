        <!-- DIAGRAM HEADER TITLE -->
        <mxCell id="title_banner" value="&lt;div style=&quot;font-size: 17px; font-weight: 800; color: #F8FAFC; letter-spacing: 0.05em;&quot;&gt;SƠ ĐỒ THỰC THỂ QUAN HỆ (ERD) - CSDL LUỒNG TIẾP NHẬN BẢO HÀNH (L2)&lt;/div&gt;&lt;div style=&quot;font-size: 12px; color: #94A3B8; margin-top: 4px;&quot;&gt;Hệ thống: Mekong Mobile CRM | Chuẩn Crow&#39;s Foot Notation | Học phần: Chuyên đề 1&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
