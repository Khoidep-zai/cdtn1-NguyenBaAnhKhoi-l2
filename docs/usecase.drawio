        <!-- UML DEPENDENCIES: <<EXTEND>> UC1_Ext -> UC1 -->
        <mxCell id="EdgeExt_UC1" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#38BDF8;strokeWidth=1.5;dashed=1;endArrow=open;fontColor=#38BDF8;fontSize=11;fontStyle=2;" edge="1" parent="SystemBoundary" source="UC1_Ext" target="UC1">
