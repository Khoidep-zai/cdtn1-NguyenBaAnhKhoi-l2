        <!-- LEGEND & STEREOTYPES BOX -->
        <mxCell id="legend_box" value="&lt;div style=&quot;font-weight: 700; color: #F8FAFC; margin-bottom: 6px; font-size: 12px; border-bottom: 1px solid #334155; padding-bottom: 4px;&quot;&gt;CHÚ THÍCH QUAN HỆ UML (LEGEND)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; line-height: 1.6; color: #94A3B8;&quot;&gt;— &lt;strong style=&quot;color: #E2E8F0;&quot;&gt;Association (Đường nét liền):&lt;/strong&gt; Tác nhân tham gia tương tác trực tiếp với ca sử dụng.&lt;br&gt;⇢ &lt;strong style=&quot;color: #38BDF8;&quot;&gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; (Bắt buộc):&lt;/strong&gt; Khi thực thi UC nguồn thì BẮT BUỘC phải thực thi UC đích kèm theo.&lt;br&gt;⇢ &lt;strong style=&quot;color: #94A3B8;&quot;&gt;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt; (Mở rộng):&lt;/strong&gt; UC nguồn chỉ được kích hoạt mở rộng khi thỏa mãn điều kiện rẽ nhánh.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#475569;strokeWidth=1;align=left;verticalAlign=top;padding=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="845" width="700" height="65" as="geometry" />
        </mxCell>

