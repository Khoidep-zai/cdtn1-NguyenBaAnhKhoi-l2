  <diagram id="usecase_diagram_l2" name="Use Case - Luồng L2 Bảo Hành">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="920" background="#0F172A" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- DIAGRAM HEADER TITLE -->
        <mxCell id="title_banner" value="&lt;div style=&quot;font-size: 17px; font-weight: 800; color: #F8FAFC; letter-spacing: 0.05em;&quot;&gt;SƠ ĐỒ CA SỬ DỤNG (USE CASE DIAGRAM) - PHÂN HỆ TIẾP NHẬN BẢO HÀNH (L2)&lt;/div&gt;&lt;div style=&quot;font-size: 12px; color: #94A3B8; margin-top: 4px;&quot;&gt;Hệ thống: Mekong Mobile CRM | Tiêu chuẩn UML 2.5 | Phạm vi: Tiếp nhận &amp; Phân loại sự cố (L2)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1170" height="50" as="geometry" />
        </mxCell>

        <!-- SYSTEM BOUNDARY -->
        <mxCell id="SystemBoundary" value="Phân hệ Tiếp nhận &amp; Phân loại yêu cầu bảo hành (Luồng L2 - Mekong Mobile)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fontStyle=1;fontSize=13;fontColor=#F8FAFC;fillColor=rgba(15, 23, 42, 0.6);strokeColor=#3B82F6;strokeWidth=2;rounded=1;arcSize=8;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="700" height="740" as="geometry" />
        </mxCell>

        <!-- PRIMARY ACTOR: RECEPTIONIST (LEFT) -->
        <mxCell id="Actor_Receptionist" value="&lt;div style=&quot;font-weight: 700; color: #F8FAFC; margin-top: 6px; font-size: 13px;&quot;&gt;Nhân viên tiếp nhận&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;(Receptionist - Quầy lễ tân)&lt;/div&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#818CF8;strokeWidth=2;fillColor=#1E293B;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="55" height="100" as="geometry" />
        </mxCell>

        <!-- SECONDARY ACTOR: CENTER MANAGER (RIGHT TOP) -->
        <mxCell id="Actor_Manager" value="&lt;div style=&quot;font-weight: 700; color: #F8FAFC; margin-top: 6px; font-size: 13px;&quot;&gt;Quản lý trung tâm&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;(Center Manager)&lt;/div&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#FBBF24;strokeWidth=2;fillColor=#1E293B;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="1060" y="240" width="55" height="100" as="geometry" />
        </mxCell>

        <!-- EXTERNAL SYSTEM ACTOR: ERP / KHO BÁN LẺ (RIGHT BOTTOM) -->
        <mxCell id="Actor_ERP" value="&lt;div style=&quot;font-weight: 700; color: #F8FAFC; margin-top: 6px; font-size: 12px;&quot;&gt;&amp;lt;&amp;lt;System&amp;gt;&amp;gt;&lt;br&gt;Hệ thống ERP / Kho bán lẻ&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #94A3B8;&quot;&gt;(Tra cứu IMEI &amp; Hóa đơn)&lt;/div&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#34D399;strokeWidth=2;fillColor=#1E293B;fontColor=#F8FAFC;" vertex="1" parent="1">
          <mxGeometry x="1060" y="560" width="55" height="100" as="geometry" />
        </mxCell>

        <!-- USE CASE 1: SEARCH CUSTOMER & DEVICE -->
        <mxCell id="UC1" value="&lt;b&gt;UC1: Tra cứu hồ sơ&lt;br&gt;Khách hàng &amp; Thiết bị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;(Theo SĐT / IMEI - FR1)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="40" y="60" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- USE CASE 1.1: EXTEND - CREATE NEW CUSTOMER (QT-01) -->
        <mxCell id="UC1_Ext" value="&lt;b&gt;Đăng ký hồ sơ&lt;br&gt;Khách hàng mới&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;(Khi SĐT chưa có - QT-01)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#CBD5E1;fontSize=11;strokeStyle=dashed;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="420" y="60" width="230" height="65" as="geometry" />
        </mxCell>

        <!-- USE CASE 2: CREATE WARRANTY TICKET (CORE) -->
        <mxCell id="UC2" value="&lt;b&gt;UC2: Khởi tạo phiếu&lt;br&gt;tiếp nhận bảo hành&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #38BDF8;&quot;&gt;(Cốt lõi luồng L2 - FR2 / US2)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#312E81;strokeColor=#818CF8;strokeWidth=2.5;fontColor=#FFFFFF;fontSize=12.5;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="35" y="240" width="230" height="75" as="geometry" />
        </mxCell>

        <!-- USE CASE 2.1: INCLUDE - VERIFY WARRANTY (QT-05) -->
        <mxCell id="UC2_Inc1" value="&lt;b&gt;Xác minh thời hạn&lt;br&gt;bảo hành thiết bị&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;(QT-05: Ngày mua &amp; Serial)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#E2E8F0;fontSize=11;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="420" y="180" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- USE CASE 2.2: INCLUDE - FAULT CATEGORIZATION & SLA (FR3 / QT-04) -->
        <mxCell id="UC2_Inc2" value="&lt;b&gt;Phân loại sự cố &amp;&lt;br&gt;Tự động tính SLA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;(FR3 / QT-04: Hạn 24h/72h)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#E2E8F0;fontSize=11;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="420" y="260" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- USE CASE 2.3: EXTEND - PRINT RECEIPT -->
        <mxCell id="UC2_Ext" value="&lt;b&gt;In biên nhận&lt;br&gt;tiếp nhận cho khách&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;(In phiếu bàn giao máy)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#CBD5E1;fontSize=11;strokeStyle=dashed;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="420" y="340" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- USE CASE 3: UPDATE STATUS (FR4 / QT-06) -->
        <mxCell id="UC3" value="&lt;b&gt;UC3: Cập nhật trạng thái&lt;br&gt;phiếu bảo hành&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #FBBF24;&quot;&gt;(MỚI → ĐÃ PHÂN CÔNG - FR4)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="35" y="460" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- USE CASE 3.1: INCLUDE - AUDIT TRAIL LOG (FR4) -->
        <mxCell id="UC3_Inc" value="&lt;b&gt;Ghi nhật ký lịch sử&lt;br&gt;chuyển trạng thái&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;(Bảng ticket_status_log - QT-06)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#E2E8F0;fontSize=11;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="420" y="465" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- USE CASE 4: VIEW & FILTER TICKETS (FR5 / US6) -->
        <mxCell id="UC4" value="&lt;b&gt;UC4: Tra cứu &amp; Lọc&lt;br&gt;danh sách phiếu bảo hành&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #94A3B8;&quot;&gt;(Lọc theo Status, Center - FR5)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="SystemBoundary">
          <mxGeometry x="40" y="580" width="220" height="65" as="geometry" />
